{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001",
      "http://localhost:5173",
      "http://localhost:8080",
      "https://localhost:3000",
      "https://localhost:3001",
      "https://localhost:5173",
      "https://localhost:8080"
    ],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "DELETE",
      "OPTIONS",
      "PATCH"
    ],
    "AllowedHeaders": [
      "*"
    ],
    "AllowCredentials": true,
    "MaxAge": 3600
  },
  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "UseSsl": true,
    "SmtpUsername": "your-email@gmail.com",
    "SmtpPassword": "your-app-password",
    "FromEmail": "noreply@ticketingplatform.com",
    "FromName": "Ticketing Platform",
    "IsEnabled": true,
    "TimeoutSeconds": 30
  },
  "PayAza": {
    "ApiKeyTest": "test-api-key-development",
    "ApiKeyLive": "live-api-key-not-used-in-dev",
    "SecretKeyTest": "test-secret-key-development",
    "SecretKeyLive": "live-secret-key-not-used-in-dev",
    "Mode": "test",
    "MerchantKey": "dev-merchant-key",
    "BaseUrlTest": "https://api-test.payaza.africa",
    "BaseUrlLive": "https://api.payaza.africa",
    "TimeoutSeconds": 30,
    "MaxRetryAttempts": 3,
    "InitialBackoffDelayMs": 1000
  }
}
